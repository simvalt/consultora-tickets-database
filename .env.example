# Copia a .env (no se versiona). Valores SOLO para desarrollo local.
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=tickets
POSTGRES_PORT=5432
# URL usada por Alembic y los seeds (host=localhost fuera de Docker)
DATABASE_URL=postgresql://tickets:change_me_local@localhost:5432/tickets

# Entorno: local | production. El seed demo se niega a correr en production.
APP_ENV=local

# Administrador inicial (seed base). En production usa una contraseña propia y fuerte.
ADMIN_EMAIL=admin@consultora.local
ADMIN_PASSWORD=Admin#Local1234
ADMIN_NAME=Administrador

# Credenciales de los usuarios demo (solo local)
DEMO_PASSWORD=Demo#Local1234
